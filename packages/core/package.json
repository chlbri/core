{
  "name": "@bemedev/core",
  "version": "1.6.0",
  "description": "The core library of @bemedev, providing essential functionalities and utilities for the Bemedev ecosystem.",
  "keywords": [
    "@bemedev",
    "bemedev",
    "core",
    "functions",
    "typings",
    "utilities"
  ],
  "homepage": "https://github.com/chlbri/core/blob/main/packages/core/README.md",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/core"
  },
  "bin": {
    "core": "lib/scripts/cli/index.js"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "vp run pack && chmod +x lib/scripts/cli/index.js",
    "build:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- vp run build",
    "_ci": "vp run lint && vp run test",
    "clean": "vp run rm && vp run config",
    "config": "vp install",
    "config:off": "vp install --offline",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp fmt && vp lint --fix",
    "lint:fix": "vp lint --fix",
    "lint:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- vp run lint",
    "manifest": "vpx src/scripts/manifest/generate.ts",
    "posttest": "vp fmt",
    "pretest": "vp run build",
    "rinit": "vp run rm && vp run config",
    "rinit:off": "vp run rm && vp run config:off",
    "rimraf": "vp dlx rimraf -rf",
    "rm": "vp run rimraf -- node_modules pnpm-lock.yaml ",
    "rm:lib": "vp dlx rimraf ./lib",
    "test": "vp run test:coverage",
    "test:coverage": "vp test run --coverage",
    "test:only": "vp run test:coverage --no-coverage",
    "test:ui": "vp test --ui",
    "test:watch": "vp test",
    "upgrade": "vp update --latest"
  },
  "dependencies": {
    "@bemedev/codebase": "catalog:",
    "cmd-ts": "catalog:",
    "edit-json-file": "catalog:",
    "ts-morph": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "catalog:",
    "@types/edit-json-file": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "onchange": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
